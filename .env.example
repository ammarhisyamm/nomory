# Salin file ini ke .env (lokal) atau set via `wrangler secret put` (produksi).
# JANGAN commit file .env yang berisi nilai asli.

# Google OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret untuk signing session cookie + pepper hash password.
# Wajib di produksi. Generate: openssl rand -hex 32
SESSION_SECRET=

# Resend (email reset password)
RESEND_API_KEY=

# Opsional
# APP_ORIGIN=https://nomory.site
# EMAIL_FROM=Nomory <hello@nomory.site>
# SIGNUP_DISABLED=false
